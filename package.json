{
  "name": "cypress-framework-for-end-to-end-testing",
  "version": "1.0.0",
  "description": "Learning node.js",
  "main": "index.js",
  "scripts": {
    "start": "nodemon index.js",
    "lint": "eslint .",
    "cypress:local:ui": "cypress open",
    "cypress:ui": "cypress open",
    "cypress:api": "cypress open",
    "test": "cypress run",
    "test:api": "cypress open --e2e --config specPattern=cypress/api/**/*_spec.js",
    "test:ui": "cypress open --e2e --config specPattern=cypress/e2e/**/*_spec.js"
  },
  "author": "Shobhit",
  "license": "ISC",
  "dependencies": {
    "slugify": "~1.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^15.15.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "nodemon": "^1.18.11",
    "wait-on": "^9.0.10"
  }
}
